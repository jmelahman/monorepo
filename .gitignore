# Repo-wide ignores. Subprojects keep their own .gitignore for
# project-specific build outputs (binaries, dist/, etc.).

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# Frontend
node_modules/
dist/
*.tsbuildinfo

# Go
*.test
*.out

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Secrets
.env

# Homelab data (docker-compose volumes)
homelab/audiobooks/
homelab/auth/
homelab/certbot/
homelab/config/
homelab/etc-pihole/
homelab/metadata/
homelab/podcasts/

# Editor / AI tooling
settings.local.json
plans/
