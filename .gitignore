# Node
node_modules/
dist/
*.tsbuildinfo

# Vite's dependency-optimizer cache. Machine-local and regenerated on demand;
# Biome reads this file, so leaving it tracked also fails `npm run check`.
.vite/

# env file
.env

# Local planning artifacts
plans/
.playwright-mcp/
.tmp/

# Block all PNGs by default to keep dev/Playwright screenshots out of commits.
# Allowlist legit asset locations below; use `git add -f` for one-off exceptions.
*.png
!assets/*.png
# Play listing art, rendered by tools/gen-store-art.sh. Committed for the same
# reason the launcher icons are: nothing in CI can render an SVG, and the upload
# form wants a file rather than a build step.
!assets/store/*.png
# The listing screenshots, captured from a scripted playthrough rather than
# rendered, which is why they are committed and not generated: reproducing them
# means driving the app to a shop, a pack and a boss again, and the upload form
# wants eight files rather than a recipe for them.
!assets/store/screenshots/*.png
# Android launcher icons are generated by `cap add android` and MUST be
# committed, or the APK build fails on missing mipmap resources.
!android/**/*.png
.claude-tmp/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Android build output is handled by android/.gitignore, generated by
# `cap add android`. The android/ directory itself is committed.

