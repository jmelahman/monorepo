{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Kanban Tests",
      "type": "shell",
      "command": "go",
      "args": ["test", "./agentic-kanban/..."],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Kanban Backend",
      "type": "shell",
      "command": "go",
      "args": ["run", "./agentic-kanban", "serve"],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Kanban Frontend",
      "type": "shell",
      "command": "npm install && npm run dev -- --host 0.0.0.0",
      "options": {
        "cwd": "${workspaceFolder}/agentic-kanban/web"
      }
    }
  ]
}
