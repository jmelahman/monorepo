{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "5 Wild",
  "mainBinaryName": "5-wild",
  "identifier": "com.jmelahman.fivewild",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis"],
    "category": "Game",
    "shortDescription": "A word-guessing roguelike",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "linux": {
      "deb": {
        "depends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
