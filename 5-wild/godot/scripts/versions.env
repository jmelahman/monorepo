# Every download the project makes, pinned by version and sha256. Sourced by
# scripts/env.sh (so every script sees it) and by the devcontainer build, which
# bakes the same Godot in. Bumping one: change the version, run
# `scripts/setup.sh` once with the new url, and paste the sha256 it prints on
# mismatch. Nothing here is fetched without its checksum.

GODOT_VERSION=4.7.2
GODOT_RELEASE="https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}-stable"
GODOT_SHA256_X86_64=cadd3204e728a35d3f13adb7fd0d7902636b79f6b95c40c265eb73b6c35329e4
GODOT_SHA256_ARM64=5dd0d86405cf7e8adf79fb6377b38ba682a2846cb378ffe5364f38c01ad29b9d
# 1.3 GB, and only needed to export: `scripts/setup.sh templates`.
GODOT_TEMPLATES_SHA256=f298490b8d44d934be425a5a65a51bf15f422428b229a06a6e11d9ffea248011

GDUNIT4_VERSION=6.2.1
GDUNIT4_URL="https://github.com/godot-gdunit-labs/gdUnit4/archive/refs/tags/v${GDUNIT4_VERSION}.tar.gz"
GDUNIT4_SHA256=cec19e2241f4dbd6c47795083d0ec51d1103a8a9f6198d15d436e9d0e09b8ec0

# The GDExtension build, which works with the stock editor and export
# templates; the module build would mean compiling Godot. "plugin-4.4" is the
# minimum Godot it targets, not the one it was built for.
GODOTSTEAM_VERSION=4.22.1
GODOTSTEAM_URL="https://codeberg.org/godotsteam/godotsteam/releases/download/v${GODOTSTEAM_VERSION}-gde/godotsteam-${GODOTSTEAM_VERSION}-gdextension-plugin-4.4.zip"
GODOTSTEAM_SHA256=2b12b3499434c50da16104a0d22b725aee15cc5cd41223c1cea825bae59bfa8f

# The linter and formatter, from PyPI rather than a checksummed archive; keep
# it in step with the gdtoolkit rev in .pre-commit-config.yaml. The image bakes
# it in, and scripts/lint.sh falls back to `uvx` where it is not installed.
GDTOOLKIT_VERSION=4.5.0
