{
  "name": "5-wild",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun check && vite build",
    "preview": "vite preview",
    "typecheck": "bun check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "apk": "bun run build && cap sync android && cd android && ./gradlew assembleDebug",
    "golden": "UPDATE_GOLDEN=1 vitest run test/golden.test.ts",
    "sim": "SIM=1 vitest run test/sim.test.ts",
    "relics": "bun tools/relics.ts",
    "builds": "bun tools/builds.ts",
    "telemetry": "vitest run test/telemetry-report.test.ts",
    "bench:mcp": "bun tools/bench/mcp.ts",
    "bench:baseline": "bun tools/bench/baseline.ts",
    "bench:report": "bun tools/bench/report.ts",
    "bench:export": "bun tools/bench/export.ts",
    "bench:replay": "bun tools/bench/feed.ts --replay",
    "bench:opencode": "bun tools/bench/opencode.ts",
    "bench:record": "bun tools/bench/record.ts",
    "bench:upload": "bun tools/bench/upload.ts",
    "bench:charts": "bun tools/bench/charts.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jersey-20": "^5.3.0",
    "@fontsource/jost": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "oxlint": "1.90.0",
    "playwright-core": "^1.64.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
