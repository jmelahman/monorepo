{
  "mcpServers": {
    "playwright": {
      "command": "bunx",
      "args": [
        "@playwright/mcp",
        "--browser",
        "chromium",
        "--headless",
        "--isolated",
        "--no-sandbox"
      ]
    },
    "kanban": {
      "command": "go",
      "args": ["run", ".", "mcp", "--server", "http://kanban:7474"]
    }
  }
}
