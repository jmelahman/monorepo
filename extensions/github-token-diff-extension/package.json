{
  "name": "github-token-diff-extension",
  "version": "0.1.4",
  "private": true,
  "description": "Firefox extension to estimate the token delta of a GitHub pull request",
  "type": "module",
  "scripts": {
    "test": "node --test test/",
    "lint": "web-ext lint --source-dir=.",
    "start": "web-ext run --source-dir=.",
    "build": "web-ext build --source-dir=. --overwrite-dest",
    "sign": "web-ext sign --source-dir=. --channel=listed"
  },
  "devDependencies": {
    "web-ext": "^10.8.0"
  }
}
