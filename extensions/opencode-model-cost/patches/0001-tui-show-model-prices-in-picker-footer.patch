+/** The compact price shown in a picker row's trailing slot, or undefined when the catalog has none. */
+export function formatModelPrice(model: {
+  cost: ReadonlyArray<{ tier?: { readonly type: "context"; readonly size: number }; input: number; output: number }>
+}) {
+  if (isFreeModel(model)) return "Free"
+  const cost = model.cost.find((cost) => cost.tier === undefined) ?? model.cost[0]
+  if (!cost) return undefined
+  return `${usd(cost.input)}/${usd(cost.output)}`
