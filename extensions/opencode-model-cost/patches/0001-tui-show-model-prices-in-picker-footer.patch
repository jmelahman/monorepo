+import { formatModelPrice, prioritizeFavorites, sortModelOptions } from "../../../../src/component/model-options"
+
+describe("formatModelPrice", () => {
+  test("formats a paid model's input and output price per million tokens", () => {
+    expect(formatModelPrice({ cost: [{ input: 3, output: 15 }] })).toBe("$3/$15")
+  })
+
+  test("keeps fractional prices readable", () => {
+    expect(formatModelPrice({ cost: [{ input: 0.125, output: 0.625 }] })).toBe("$0.125/$0.625")
+  })
+
+  test("uses the untiered entry when context tiers are present", () => {
+    expect(
+      formatModelPrice({
+        cost: [{ tier: { type: "context", size: 200_000 }, input: 6, output: 22.5 }, { input: 3, output: 15 }],
+      }),
+    ).toBe("$3/$15")
+  })
+
+  test("shows sub-cent prices without rounding them to zero", () => {
+    expect(formatModelPrice({ cost: [{ input: 0.0001, output: 0.0002 }] })).toBe("<$0.001/<$0.001")
+  })
+
+  test("labels a model with no input cost as Free", () => {
+    expect(formatModelPrice({ cost: [{ input: 0, output: 4 }] })).toBe("Free")
+  })
+
+  test("returns nothing when the catalog has no cost", () => {
+    expect(formatModelPrice({ cost: [] })).toBeUndefined()
+  })
+})
 
