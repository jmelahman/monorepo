#!/usr/bin/env bash
set -eo pipefail

shopt -s globstar

DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
SITE_URL="https://jamison.lahman.dev"
BLOG_DIR="blog"

# Opt-outs for the slow steps, used by ./serve for quick local previews.
SKIP_FEED="${SKIP_FEED:-}"
SKIP_CSS="${SKIP_CSS:-}"

pushd "$DIR" >/dev/null || exit

# Compile HTML
pages=()
for md in **/*.md; do
	if [ "$(basename "$md")" == "README.md" ]; then
		continue
	fi
	pages+=("$md")
done
uv run scripts/render.py --variable=header=true "${pages[@]}"

if [ -z "$SKIP_FEED" ]; then
	python3 scripts/build-feed.py | uv run scripts/render.py \
		-o feed/index.html \
		--variable=header=true \
		--variable=title-prefix=Feed \
		--variable=nav_feed=true
fi

# Minify CSS
if [ -z "$SKIP_CSS" ]; then
	./css/minify
fi

# Posts that have moved leave a page behind that forwards to the new address.
redirect() {
	cat >"$BLOG_DIR/$1.html" <<EOF
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Moved</title>
  <link rel="canonical" href="$SITE_URL/$BLOG_DIR/$2.html">
  <meta http-equiv="refresh" content="0; url=$2.html">
</head>
<body>
  <p>This post has moved to <a href="$2.html">$2.html</a>.</p>
</body>
</html>
EOF
}
redirect 1 my-git-workflow
redirect 2 packaging-go-with-uv

# Start RSS feed
RSS_PATH="rss.xml"
{
	cat <<EOF
<?xml version="1.0"?>
<rss version="2.0">
<channel>
  <title>jmelahman's blog</title>
  <link>$SITE_URL</link>
  <description>My personal site</description>
  <language>en-us</language>
  <lastBuildDate>$(date -R)</lastBuildDate>
EOF

	for md in "$BLOG_DIR"/*.md; do
		filename=$(basename "$md" .md)
		[ "$filename" = "index" ] && continue

		title=$(sed -n 's/^#\s[ ]*//p' "$md")
		date=$(sed -n 's/^date:[ ]*//p' "$md")
		pubDate=$(date -R -d "$date")

		cat <<EOF
  <item>
    <title>$title</title>
    <link>$SITE_URL/$BLOG_DIR/$filename.html</link>
    <guid>$SITE_URL/$BLOG_DIR/$filename.html</guid>
    <pubDate>$pubDate</pubDate>
  </item>
EOF
	done

	cat <<EOF
</channel>
</rss>
EOF
} >"$RSS_PATH"

popd >/dev/null || exit
