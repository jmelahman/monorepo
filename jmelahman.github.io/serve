#!/usr/bin/env bash
set -eo pipefail

DIR="$(cd -- "$(dirname -- "$0")" && pwd)"

# Generate the HTML before serving. The feed needs the network, so skip it
# unless its output is missing.
[ -f "$DIR/feed/index.html" ] && export SKIP_FEED=1
"$DIR/build"

# Rebuilds and reloads the browser as the sources change.
python3 "$DIR/scripts/dev-server.py" &
# shellcheck disable=SC2064 # We want this to expand immediately.
trap "kill -9 $!" EXIT
xdg-open http://localhost:8000

# Leave the script running to avoid the trap
cat >/dev/null
