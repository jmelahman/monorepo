{
  "name": "OpenCycle UE Spike",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "../.."
  },
  "workspaceMount": "source=${localEnv:HOME}/.cache/opencycle-neural/ue,target=/workspace/ue,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace/ue",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace/opencycle,type=bind,readonly",
    "source=opencycle-ue-ddc,target=/workspace/ddc,type=volume"
  ],
  "runArgs": [
    "--device=/dev/dri",
    "--group-add=${localEnv:OPENCYCLE_UE_RENDER_GID}",
    "--group-add=${localEnv:OPENCYCLE_UE_VIDEO_GID}",
    "--shm-size=8g"
  ],
  "containerUser": "ue4",
  "remoteUser": "ue4"
}
