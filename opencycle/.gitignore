# CC0 art, fetched by scripts/fetch_assets.py at the md5s in assets.lock.json.
assets/polyhaven/
assets/bake-sources/
addons/gdUnit4/

build/
captures/
*.tmp
__pycache__/
.ruff_cache/

# Local planning artifacts
plans/
.claude/settings.local.json
