root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# shfmt indents with tabs, and so does the Unreal C++.
[*.{sh,env,h,cpp,cs}]
indent_style = tab
indent_size = 4

[*.{py,yml,yaml,json,toml}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2
