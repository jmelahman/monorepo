    "ghostty-web": "^0.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-rnd": "^10.5.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
